# XServer Staging 用 .env のひな形。
# サーバーの <appDir>/shared/.env として配置し、値を埋める（Git にはコミットしない）。
# APP_KEY はサーバー上で `php8.x artisan key:generate --force` を実行するか、
# ローカルで `php artisan key:generate --show` の出力を貼り付ける。

APP_NAME="Agent CMS (staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://ドメイン名

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

# 日時はこの時間帯で読み書きする（予約公開・管理画面の日時・お知らせの日付）。
# 消すと Laravel の既定 UTC になり、「10:00」に予約したページが日本時間の 19:00 まで出ない。
APP_TIMEZONE=Asia/Tokyo

LOG_CHANNEL=daily
LOG_LEVEL=warning

# サーバーパネル > MySQL設定 で作成した値（現行サーバーは localhost）
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# staging のメールは MAIL_STAGING_REDIRECT_TO へ全件リダイレクトされる（実顧客へ送られない）。
# 未設定なら MAIL_ADMIN_ADDRESS へ。どちらも未設定なら log 出力のみになる。
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=
MAIL_STAGING_REDIRECT_TO=

# Cloudflare Turnstile（staging も本番キーまたは公式テストキーを .env で管理）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push (VAPID)。`php artisan notifications:vapid-keys` で生成
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
