{
    "provider": "xserver",
    "target": "staging",
    "ssh": {
        "host": "サーバーID.xsrv.jp",
        "port": 10022,
        "user": "サーバーID",
        "identityFile": "~/.ssh/xserver_staging"
    },
    "remote": {
        "appDir": "/home/サーバーID/agentcms/staging",
        "docroot": "/home/サーバーID/ドメイン名/public_html",
