    },
    "app": {
        "url": "https://ドメイン名",
        "healthPath": "/healthz"
    },
    "keepReleases": 3,
    "api": {
        "servername": "サーバーID.xsrv.jp",
        "dbSuffix": "agcms"
    }
}
