# XServer 本番用 .env のひな形。
# サーバーの <appDir>/shared/.env として配置し、値を埋める（Git にはコミットしない）。
# APP_KEY はサーバー上で `php8.x artisan key:generate --force` を実行するか、
# ローカルで `php artisan key:generate --show` の出力を貼り付ける。
#
# 🔴 staging との一番の違いは **メールが実際に届く** こと。
#    staging には MAIL_STAGING_REDIRECT_TO があり、全件を自分宛てへ寄せられるが、
#    本番にはそれが無い。**入力された宛先へそのまま送られる。**

APP_NAME="サイト名"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ドメイン名

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

# 日時はこの時間帯で読み書きする（予約公開・管理画面の日時・お知らせの日付）。
# 消すと Laravel の既定 UTC になり、「10:00」に予約したページが日本時間の 19:00 まで出ない。
APP_TIMEZONE=Asia/Tokyo

LOG_CHANNEL=daily
LOG_LEVEL=warning

# サーバーパネル > MySQL設定 で作成した値（現行サーバーは localhost）
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# 🔴 **MAIL_MAILER=log にしない。**
#    log は 1 通も届かないのに **エラーも出ない**。「問い合わせが来ない」としてしか
#    現れず、来ないことは誰も気づけない。`agentcms deploy doctor` がここを見て、
#    本番で log / 未設定なら FAIL にする。
#
# 差出人（MAIL_FROM_ADDRESS）も必ず埋める。空や example. のままだと
# **受信側が弾く**ので、smtp になっていても届かない側に倒れる。
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# 問い合わせの通知先。空ならサイト設定の宛先へ落ちる
MAIL_ADMIN_ADDRESS=

# Cloudflare Turnstile（本番キー）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push (VAPID)。`php artisan notifications:vapid-keys` で生成
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
