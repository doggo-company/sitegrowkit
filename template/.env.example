APP_NAME="SiteGrowKit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8180

# ホスト側の公開ポート（docker-compose が参照。agentcms create が空きポートを選んで記録する）
APP_PORT=8180
DB_FORWARD_PORT=33060
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# Docker compose project identity（agentcms create / dev が project 固有の値を生成する。
# 手動で docker compose を使う場合も、他プロジェクトと重複しない値にすること）
COMPOSE_PROJECT_NAME=

# 管理者ログイン（agentcms create / dev が安全なランダムパスワードを生成して設定する。
# 値は .agentcms/local/admin-credentials.json にも保存される — どちらも Git 対象外）
ADMIN_EMAIL="admin@example.test"
ADMIN_PASSWORD=

APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# コンテナ内から見た接続情報（ホストからは 127.0.0.1:${DB_FORWARD_PORT}）
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agentcms
DB_USERNAME=agentcms
DB_PASSWORD=agentcms

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# auto = APP_URL が https のときだけ secure を付ける。
# 直に true と書くと、http のサイトでは cookie が保存されずログインし続けられない。
SESSION_SECURE_COOKIE=auto

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# 毎日の自動 backup（HH:MM）。空なら自動では取らない。動かすにはサーバーの cron で schedule:run
AGENTCMS_BACKUP_SCHEDULE=
# backup の写しを置く別の置き場所。空なら送らない（backup はこのサーバーの中だけ）
#   別のディレクトリ: AGENTCMS_BACKUP_OFFSITE_DISK=backup-offsite と AGENTCMS_BACKUP_OFFSITE_ROOT=/絶対パス
#   S3 互換（R2・B2・MinIO）: AGENTCMS_BACKUP_OFFSITE_DISK=s3 と AWS_* （composer require league/flysystem-aws-s3-v3）
AGENTCMS_BACKUP_OFFSITE_DISK=
AGENTCMS_BACKUP_OFFSITE_ROOT=
# 1 つの置き場所を複数サイトで使うときの、このサイトの場所（空なら APP_URL の host）
AGENTCMS_BACKUP_OFFSITE_PREFIX=
AGENTCMS_BACKUP_OFFSITE_KEEP=14
# 自動 backup が失敗したら知らせる宛先（カンマ区切り）。空なら送らない（失敗は管理画面と --list には出る）
AGENTCMS_BACKUP_ALERT_MAIL=
QUEUE_CONNECTION=database

CACHE_STORE=database

# ローカルメールは Mailpit のみ（実 SMTP を設定しないこと）
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# 問い合わせ管理者通知の宛先
MAIL_ADMIN_ADDRESS="admin@example.test"

# Cloudflare Turnstile
# 下記は Cloudflare 公式のテストキー（常に成功 / 公開情報）。本番キーは絶対にコミットしない。
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Web Push (VAPID)。`php artisan notifications:vapid-keys` で生成して貼り付ける。
# 未設定の場合 Push は自動的に無効（管理画面・問い合わせ処理には影響しない）。秘密鍵はコミット禁止。
VAPID_SUBJECT="mailto:admin@example.test"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"

# agentcms template apply — テンプレート外部依存の CSP 許可（ADR-0010）
# 同梱サンプルが実際に使う origin だけを書く（同梱サンプルは外部の script を読まないので空）。
# import したテンプレートが外部依存を持っていれば apply が検出して自動で追記する
AGENTCMS_CSP_SCRIPT_SRC=
