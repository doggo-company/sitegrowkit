{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8180/",
        "http://localhost:8180/about",
        "http://localhost:8180/service",
        "http://localhost:8180/works",
        "http://localhost:8180/news",
        "http://localhost:8180/contact",
        "http://localhost:8180/works/imported-work-1"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "budgets": [
          {
            "path": "/*",
            "resourceSizes": [
              {
                "resourceType": "script",
                "budget": 100
              },
              {
                "resourceType": "stylesheet",
                "budget": 30
              },
              {
                "resourceType": "document",
                "budget": 50
              },
              {
                "resourceType": "total",
                "budget": 500
              }
            ]
          }
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "performance-budget": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}