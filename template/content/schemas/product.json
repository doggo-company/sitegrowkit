    { "id": "01KZTC0000FIELDFEATRPT023", "key": "features", "type": "repeater", "label": "特長", "validation": { "maxItems": 5 }, "fields": [
      { "id": "01KZTC0000FIELDFHEAD00024", "key": "heading", "type": "text", "label": "見出し", "required": true, "max": 60 },
      { "id": "01KZTC0000FIELDFDETAIL025", "key": "detail", "type": "textarea", "label": "説明", "max": 300 },
      { "id": "01KZTC0000FIELDFICON00026", "key": "icon_id", "type": "media", "label": "アイコン" }
