    { "id": "01KZTC0000FIELDPUBAT00017", "key": "published_at", "type": "datetime", "label": "公開日時" },
    { "id": "01KZTC0000FIELDGALLERY018", "key": "gallery", "type": "images", "label": "ギャラリー", "validation": { "maxItems": 8 } },
    { "id": "01KZTC0000FIELDRELITEM019", "key": "related_items", "type": "relations", "label": "関連商品", "target": "works", "validation": { "maxItems": 4 } },
    { "id": "01KZTC0000FIELDSPECS00020", "key": "specs", "type": "group", "label": "仕様", "fields": [
