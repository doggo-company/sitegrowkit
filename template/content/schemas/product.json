{
  "id": "product",
  "label": "商品",
  "kind": "collection",
  "table": "products",
  "fields": [
    { "id": "01KZTC0000FIELDTITLE00001", "key": "title", "type": "text", "label": "商品名", "required": true, "max": 120, "searchable": true, "sortable": true },
    { "id": "01KZTC0000FIELDSLUG000002", "key": "slug", "type": "slug", "label": "スラッグ", "from": "title", "required": true, "unique": true, "max": 120, "help": "このページの住所になります（半角の英数字とハイフン）。空のままにすると見出しから作ります。日本語だけの見出しのときは日付から作ります（例: 2026-09-03-1）。あとから直せます" },
    { "id": "01KZTC0000FIELDSUMMARY03A", "key": "summary", "type": "textarea", "label": "概要", "max": 300 },
    { "id": "01KZTC0000FIELDDESC000003", "key": "description", "type": "richtext", "label": "説明", "help": "商品の説明です" },
    { "id": "01KZTC0000FIELDPRICE00004", "key": "price", "type": "number", "label": "価格", "validation": { "min": 0, "max": 10000000 }, "filterable": true, "sortable": true },
    { "id": "01KZTC0000FIELDRELDATE005", "key": "release_date", "type": "date", "label": "発売日", "sortable": true },
    { "id": "01KZTC0000FIELDFEATURED06", "key": "featured", "type": "boolean", "label": "おすすめ", "default": false, "filterable": true },
    { "id": "01KZTC0000FIELDPTYPE00007", "key": "product_type", "type": "select", "label": "種別", "choices": ["physical", "digital"], "filterable": true },
    { "id": "01KZTC0000FIELDSIZE000008", "key": "size", "type": "radio", "label": "サイズ", "choices": ["s", "m", "l"] },
    { "id": "01KZTC0000FIELDTAGS000009", "key": "tags", "type": "checkbox", "label": "タグ", "choices": ["new", "sale", "limited"] },
    { "id": "01KZTC0000FIELDSHOPURL010", "key": "shop_url", "type": "url", "label": "販売ページ" },
    { "id": "01KZTC0000FIELDCONTACT011", "key": "contact_email", "type": "email", "label": "問い合わせ先" },
    { "id": "01KZTC0000FIELDTEL0000012", "key": "tel", "type": "tel", "label": "電話番号" },
    { "id": "01KZTC0000FIELDIMAGE00013", "key": "featured_image", "type": "image", "label": "メイン画像" },
