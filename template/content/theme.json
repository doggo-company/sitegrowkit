    "textMuted": "#6b6f76",
    "bg": "#ffffff",
    "bgAlt": "#f6f6f4",
    "primary": "#0f4c46",
    "primaryContrast": "#ffffff",
    "border": "#e3e4e2"
  },
  "typography": {
    "baseSize": "1rem",
    "lineHeight": "1.8",
    "sans": "'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'BIZ UDPGothic', Meiryo, sans-serif"
  },
  "spacing": {
